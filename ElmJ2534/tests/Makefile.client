# ElmJ2534 E2E bench client — cross-compile with mingw-w64, run on Windows
# Usage: make -f ElmJ2534/tests/Makefile.client   (from repo root; `make elm-client`)
# Standalone — does not reference Makefile.test (owned separately).

CC = i686-w64-mingw32-g++
OUTDIR = build/tests
TARGET = $(OUTDIR)/j2534_elm_test.exe
SRC = ElmJ2534/tests/j2534_elm_test.cpp

# No -march flags (P-LIVE-001); -static avoids runtime DLL deps on the laptop.
CFLAGS = -Wall -std=c++11 -O2 -DWIN32_LEAN_AND_MEAN -DWIN32
LDFLAGS = -static

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(SRC)
	@mkdir -p $(OUTDIR)
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)
	@echo "Built: $@"

clean:
	rm -f $(TARGET)
